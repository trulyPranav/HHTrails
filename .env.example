# API Configuration
# Use the production API base URL for build-time metadata generation.
# Do not leave this pointed at localhost for Cloudflare builds.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Site URL (used for canonical URLs and absolute OG image paths)
VITE_SITE_URL=https://hhtrails.com

# Cloudflare Pages deploy hook (Settings → Builds & deployments → Deploy hooks)
VITE_CLOUDFLARE_DEPLOY_HOOK_URL=
